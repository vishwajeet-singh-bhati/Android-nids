# Keep frozen WSL training code byte-stable across Windows Git checkouts.
/experiments/network_v5/*.py text eol=lf
/experiments/network_v5/*.sh text eol=lf

# Reproducible report source and recorded byte hashes.
docs/project_report/*.tex text eol=lf
docs/project_report/*.json text eol=lf

# Preserve attested detector assets and reference-fixture bytes on every platform.
/android/app/src/main/assets/sms/** -text -whitespace
/android/app/src/main/assets/url/** -text -whitespace
/android/app/src/androidTest/assets/rakshak/** -text -whitespace

/components/**/*.npz -text -whitespace
/components/**/*.pt -text -whitespace
/components/**/*.joblib -text -whitespace
/components/sms/python/experiments/mobilebert/checkpoints/** -text -whitespace

# Preserve imported upstream Markdown hard breaks and source formatting.
/components/** -whitespace
